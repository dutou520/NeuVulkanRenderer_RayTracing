#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) readonly uniform image2D accumImage;
layout(binding = 1) uniform sampler2D bloomTexture;
layout(binding = 2, rgba16f) writeonly uniform image2D displayImage;

layout(push_constant) uniform PushConstants {
    float exposure;
    float gamma;
    int tonemapMode; // 0 = ACES, 1 = Reinhard, 2 = Linear, 3 = HDR Linear + Soft Knee
    int bloomEnabled;
    float bloomIntensity;
    float invSPP;
    int width;
    int height;
    float peakLuminance;
    float paperWhite;
    float softKneeThreshold;
    int bloomBlendMode;           // 0 = Highlight-Preserving, 1 = Soft Screen, 2 = Smooth Envelope, 3 = Direct Additive
    float bloomHighlightPreserve; // 0.0 ~ 2.0, default 1.0
} params;

// ACES Tone Mapping curve (SDR)
vec3 tonemapACES(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Reinhard Tone Mapping (SDR)
vec3 tonemapReinhard(vec3 x) {
    return x / (x + vec3(1.0));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= params.width || pos.y >= params.height) return;

    vec4 accum = imageLoad(accumImage, pos);
    float spp = max(accum.w, 1.0);
    vec3 hdrColor = accum.rgb * params.invSPP;

    if (any(isnan(hdrColor)) || any(isinf(hdrColor))) {
        hdrColor = vec3(0.0);
    }

    // Bloom blending
    if (params.bloomEnabled != 0) {
        vec2 uv = (vec2(pos) + 0.5) / vec2(params.width, params.height);
        vec3 bloomColor = texture(bloomTexture, uv).rgb;
        vec3 bloom = bloomColor * params.bloomIntensity;

        if (params.bloomBlendMode == 0) {
            // Mode 0: Highlight-Preserving Soft Blend (保高光自适应混合)
            // 强光散射主要表现为向周围较暗区域漫散光晕，而在高光核心处抑制自加性过饱和，保护法线细节
            float baseLum = max(dot(hdrColor, vec3(0.2126, 0.7152, 0.0722)), 0.0);
            float preserveK = max(params.bloomHighlightPreserve, 0.0);
            float weight = 1.0 / (1.0 + baseLum * preserveK * 0.5);
            hdrColor += bloom * weight;
        } else if (params.bloomBlendMode == 1) {
            // Mode 1: HDR Soft Screen Blend (屏幕有理渐近软混合)
            vec3 denom = max(hdrColor, vec3(1.0)) + bloom * max(params.bloomHighlightPreserve, 0.1);
            hdrColor = hdrColor + bloom - (hdrColor * bloom) / denom;
        } else if (params.bloomBlendMode == 2) {
            // Mode 2: Smooth Envelope Fusion (平滑包络融合)
            float k = 0.5 * max(params.bloomHighlightPreserve, 0.1);
            vec3 h = clamp(0.5 + 0.5 * (bloom - hdrColor) / k, 0.0, 1.0);
            hdrColor = mix(hdrColor, bloom, h) + k * h * (1.0 - h);
        } else {
            // Mode 3: Legacy Direct Additive (传统直接线性叠加)
            hdrColor += bloom;
        }
    }

    // Exposure adjustment
    hdrColor *= params.exposure;

    if (params.tonemapMode == 3) {
        // HDR Linear + Soft Knee
        float M = max(params.peakLuminance / max(params.paperWhite, 1.0), 1.0);
        float t = M * clamp(params.softKneeThreshold, 0.5, 0.99);
        vec3 mapped = max(hdrColor, vec3(0.0));
        for (int i = 0; i < 3; ++i) {
            if (mapped[i] > t) {
                float diff = mapped[i] - t;
                float span = max(M - t, 1e-4);
                mapped[i] = t + span * tanh(diff / span);
            }
        }
        imageStore(displayImage, pos, vec4(mapped, 1.0));
    } else {
        // SDR Tonemap modes
        vec3 mapped = hdrColor;
        if (params.tonemapMode == 0) {
            mapped = tonemapACES(hdrColor);
        } else if (params.tonemapMode == 1) {
            mapped = tonemapReinhard(hdrColor);
        } else {
            mapped = clamp(hdrColor, 0.0, 1.0);
        }

        // Gamma correction
        float g = params.gamma > 0.01 ? params.gamma : 2.2;
        vec3 ldr = pow(clamp(mapped, 0.0, 1.0), vec3(1.0 / g));

        imageStore(displayImage, pos, vec4(ldr, 1.0));
    }
}
